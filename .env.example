# EasyStock 环境配置
# 复制此文件为 .env 并根据实际情况修改

# 服务端口
SERVER_PORT=8080

# 数据库配置
DB_TYPE=sqlite
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=easystock
# DB_PASSWORD=easystock
# DB_NAME=easystock

# JWT 配置（生产环境务必修改）
JWT_SECRET=change-this-to-a-strong-secret-key
JWT_EXPIRE_HOUR=24

# 部署模式: local 或 saas
DEPLOYMENT_MODE=local

# 前端 API 地址
# 使用 Traefik 时设置为相对路径 /api/v1
NEXT_PUBLIC_API_URL=/api/v1

# AI 配置（可选）
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxx
# AI_MODEL=gpt-4o

# Traefik HTTPS（可选）
# ACME_EMAIL=your@email.com
